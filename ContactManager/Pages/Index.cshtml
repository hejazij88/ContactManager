@page
@model IndexModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "All Contact";
}

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Photo</th>
            <th scope="col">Name</th>
            <th scope="col">Last Name</th>
            <th scope="col">Phone</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.contactList)
        {
            <tr>
                <td>
                    <img src="~/Contact/@item.Picture" style="width: 70px; height: 70px" />
                </td>
                <td>@item.Name</td>
                <td>@item.LastName</td>
                <td>@item.Phone</td>
            </tr>
        }
    </tbody>
</table>


