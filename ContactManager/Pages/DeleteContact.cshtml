@model Contact.Application.Share.Contacts.DeleteContactModel

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
    <h4 class="modal-title">Add Contact</h4>
</div>

<form asp-page="./Index"  asp-page-handler="DeleteContact"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">
    <div class="modal-body">
       
       
        <span>Do You Want Delete This Record?</span>

        <input hidden="true" type="text" class="form-control" asp-for="Id">

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Submit</button>
    </div>
</form>